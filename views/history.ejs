<!DOCTYPE html>
<html lang="en">
<%- include('layouts/head', { titleKey: 'history-title', title: 'Scan History - QR Scanner', includeQRScanner: false }) %>
<body>
    <%- include('layouts/navbar', { currentPage: 'history' }) %>

    <main class="main-content">
        <div class="history-container">
            <h1 data-i18n-key="history-title">Scan History</h1>


            <% if (scans && scans.length > 0) { %>
                <div class="scan-list">
                    <% scans.forEach(scan => { %>
                        <div class="scan-item <%= scan.isDuplicate ? 'duplicate-scan' : '' %>">
                            <div class="scan-content">
                                <!-- Scan Count Header -->
                                <div class="scan-header">
                                    <span class="scan-count-badge">
                                        <i class="bi bi-upc-scan"></i>
                                        <span data-i18n-key="history-scanned">Scanned</span>:
                                        <strong><%= scan.duplicateCount %></strong>
                                        <span data-i18n-key="history-times"><%= scan.duplicateCount === 1 ? 'time' : 'times' %></span>
                                    </span>
                                    <% if (scan.isDuplicate) { %>
                                        <span class="duplicate-badge">
                                            <i class="bi bi-arrow-repeat"></i> <span data-i18n-key="history-duplicate">Duplicate</span>
                                        </span>
                                    <% } %>
                                </div>

                                <p class="scan-text"><%= scan.content %></p>
                                <p class="scan-meta">
                                    <span class="scan-type"><%= scan.type %></span>

                                    <% if (scan.verification && scan.verification.isVerified) { %>
                                        <% if (scan.verification.verificationResult.success) { %>
                                            <span class="verification-badge success">
                                                🔍 <span data-i18n-key="history-verified">Verified</span> <%= scan.verification.verificationCount %>x
                                            </span>
                                        <% } else { %>
                                            <span class="verification-badge failed">
                                                ❌ <span data-i18n-key="history-verification-failed">Verification Failed</span> (<%= scan.verification.verificationResult.error.step %>)
                                            </span>
                                        <% } %>
                                    <% } %>
                                </p>

                                <!-- Scan Timeline -->
                                <div class="scan-timeline">
                                    <div class="timeline-item">
                                        <i class="bi bi-calendar-plus"></i>
                                        <span><strong data-i18n-key="history-first-scan">First Scan:</strong> <%= new Date(scan.firstScannedAt).toLocaleString() %></span>
                                    </div>
                                    <% if (scan.isDuplicate) { %>
                                    <div class="timeline-item">
                                        <i class="bi bi-calendar-check"></i>
                                        <span><strong data-i18n-key="history-last-scan">Last Scan:</strong> <%= new Date(scan.scannedAt).toLocaleString() %></span>
                                    </div>
                                    <% } %>
                                </div>


                                <% if (scan.verification && scan.verification.isVerified) { %>
                                    <div class="verification-section">
                                        <h4 data-i18n-key="history-verification-results">Verification Results</h4>
                                        <p><strong data-i18n-key="history-verified-at">Verified:</strong> <%= new Date(scan.verification.verifiedAt).toLocaleString() %></p>
                                        <p><strong data-i18n-key="history-times-verified">Times Verified:</strong> <%= scan.verification.verificationCount %></p>

                                        <% if (scan.verification.verificationResult.success) { %>
                                            <div class="verification-success">
                                                <p><strong>✅ <span data-i18n-key="history-successfully-decoded">Successfully decoded through all steps:</span></strong></p>
                                                <ul class="verification-steps-list">
                                                    <% scan.verification.verificationResult.steps.forEach(step => { %>
                                                        <li>
                                                            <strong><%= step.name %>:</strong>
                                                            <%= formatBytes(step.size) %> (<%= step.percentage %>%)
                                                        </li>
                                                    <% }) %>
                                                </ul>
                                            </div>
                                        <% } else { %>
                                            <div class="verification-error">
                                                <p><strong>❌ <span data-i18n-key="history-verification-failed-title">Verification Failed:</span></strong></p>
                                                <p><strong data-i18n-key="history-error">Error:</strong> <%= scan.verification.verificationResult.error.message %></p>
                                                <p><strong data-i18n-key="history-failed-at-step">Failed at step:</strong> <%= scan.verification.verificationResult.error.step %></p>
                                            </div>
                                        <% } %>
                                    </div>
                                <% } %>
                            </div>
                            <div class="scan-actions">
                                <button class="btn btn-small btn-verify" data-content="<%= scan.content %>" data-i18n-key="history-re-verify">Re-verify</button>
                                <button class="btn btn-small btn-copy" data-content="<%= scan.content %>" data-i18n-key="history-copy">Copy</button>
                                <button class="btn btn-small btn-danger" data-id="<%= scan._id %>" data-i18n-key="history-delete">Delete</button>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } else { %>
                <div class="empty-state">
                    <p><span data-i18n-key="history-no-scans">No scans yet.</span> <a href="/" data-i18n-key="history-start-scanning">Start scanning</a></p>
                </div>
            <% } %>
        </div>
    </main>

    <%- include('layouts/footer') %>

    <script src="/js/history.js"></script>
</body>
</html>