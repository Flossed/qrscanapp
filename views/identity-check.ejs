<!DOCTYPE html>
<html lang="en">
<%- include('layouts/head', { titleKey: 'identity-title', title: 'EHIC Verifier - Identity Check', includeQRScanner: false }) %>
<body>
    <%- include('layouts/navbar') %>
    <%- include('layouts/breadcrumb') %>

    <main class="main-content">
        <div class="identity-check-container">
            <!-- Mobile why identity check - shown only on mobile -->
            <div class="mobile-why-identity">
                <div class="info-box">
                    <h3 data-i18n-key="identity-why-title">Why Identity Verification?</h3>
                    <p data-i18n-key="identity-why-text">Identity verification ensures:</p>
                    <ul>
                        <li data-i18n-key="identity-why-item1">Patient authenticity</li>
                        <li data-i18n-key="identity-why-item2">Fraud prevention</li>
                        <li data-i18n-key="identity-why-item3">Compliance with regulations</li>
                        <li data-i18n-key="identity-why-item4">Accurate treatment records</li>
                    </ul>
                </div>
            </div>

            <div class="form-container">
                <div class="form-header">
                    <h1 data-i18n-key="identity-title">Visual Verification</h1>
                    <p data-i18n-key="identity-subtitle">Verify patient identity before finalizing the verification process</p>
                </div>

                <div class="identity-instructions">
                    <div class="prc-data-card">
                        <div class="prc-data-header">
                            <h2 data-i18n-key="identity-prc-certificate-info">PRC Certificate Information</h2>
                        </div>
                        <div class="prc-data-content" id="prc-data-display">
                            <div class="prc-data-loading" data-i18n-key="identity-loading-data">Loading PRC data...</div>
                        </div>
                    </div>

                    <div class="verification-checklist">
                        <h3 data-i18n-key="identity-checklist-title">Identity Verification</h3>
                        <div class="checklist-items">
                            <label class="checklist-item">
                                <input type="checkbox" id="identityVerified" name="verification">
                                <span class="checkmark"></span>
                                <span class="checklist-text" data-i18n-key="identity-checklist-verified">Visualized name(s) match name(s) on identity card of citizen</span>
                            </label>
                            <p class="identity-optional-note" data-i18n-key="identity-optional-note">This verification is optional. If skipped, a warning will be included in the finalization documentation.</p>
                        </div>
                    </div>
                </div>

                <!-- Mobile next steps - shown only on mobile -->
                <div class="mobile-next-steps">
                    <div class="info-box">
                        <h3 data-i18n-key="identity-next-title">Next Steps</h3>
                        <ol>
                            <li data-i18n-key="identity-next-step1">Complete finalization process</li>
                        </ol>
                    </div>
                </div>

                <div class="form-actions">
                    <button type="button" id="continueToFinalization" class="btn btn-primary btn-large" disabled>
                        <span data-i18n-key="identity-button-finalize">Continue to Finalization</span>
                        <span class="btn-arrow">→</span>
                    </button>
                </div>
            </div>

            <div class="info-sidebar">
                <div class="info-box">
                    <h3 data-i18n-key="identity-why-title">Why Identity Verification?</h3>
                    <p data-i18n-key="identity-why-text">Identity verification ensures:</p>
                    <ul>
                        <li data-i18n-key="identity-why-item1">Patient authenticity</li>
                        <li data-i18n-key="identity-why-item2">Fraud prevention</li>
                        <li data-i18n-key="identity-why-item3">Compliance with regulations</li>
                        <li data-i18n-key="identity-why-item4">Accurate treatment records</li>
                    </ul>
                </div>

                <div class="info-box">
                    <h3 data-i18n-key="identity-next-title">Next Steps</h3>
                    <ol>
                        <li data-i18n-key="identity-next-step1">Complete finalization process</li>
                    </ol>
                </div>
            </div>
        </div>
    </main>

    <%- include('layouts/footer') %>    
    <script src="/js/identity-check.js"></script>
</body>
</html>