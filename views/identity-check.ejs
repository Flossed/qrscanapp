<!DOCTYPE html>
<html lang="en">
<%- include('layouts/head', { titleKey: 'identity-title', title: 'EHIC Verifier - Identity Check', includeQRScanner: false }) %>
<body>
    <%- include('layouts/navbar') %>
    <%- include('layouts/breadcrumb') %>

    <main class="main-content">
        <div class="identity-check-container">
            <!-- Mobile why identity check - shown only on mobile -->
            <div class="mobile-why-identity">
                <div class="info-box">
                    <h3 data-i18n-key="identity-why-title">Why Identity Verification?</h3>
                    <p data-i18n-key="identity-why-text">Identity verification ensures:</p>
                    <ul>
                        <li data-i18n-key="identity-why-item1">Patient authenticity</li>
                        <li data-i18n-key="identity-why-item2">Fraud prevention</li>
                        <li data-i18n-key="identity-why-item3">Compliance with regulations</li>
                        <li data-i18n-key="identity-why-item4">Accurate treatment records</li>
                    </ul>
                </div>
            </div>

            <div class="form-container">
                <div class="form-header">
                    <h1 data-i18n-key="identity-title">Identity Check</h1>
                    <p data-i18n-key="identity-subtitle">Verify patient identity before proceeding with QR code scanning</p>
                </div>

                <div class="identity-instructions">
                    <div class="instruction-card">
                        <div class="instruction-icon">🆔</div>
                        <div class="instruction-content">
                            <h2 data-i18n-key="identity-verification-required">Identity Verification Required</h2>
                            <p data-i18n-key="identity-instruction-text">Please request the patient to show his identity card. The Identity needs to match the name, firstname, date of birth on the PRC, and date stored in the QR code. Please make a copy for your records.</p>
                        </div>
                    </div>

                    <div class="verification-checklist">
                        <h3 data-i18n-key="identity-checklist-title">Verification Checklist</h3>
                        <div class="checklist-items">
                            <label class="checklist-item">
                                <input type="checkbox" id="nameMatch" name="verification">
                                <span class="checkmark"></span>
                                <span class="checklist-text" data-i18n-key="identity-checklist-name">Name matches PRC and QR code data</span>
                            </label>
                            <label class="checklist-item">
                                <input type="checkbox" id="firstnameMatch" name="verification">
                                <span class="checkmark"></span>
                                <span class="checklist-text" data-i18n-key="identity-checklist-firstname">First name matches PRC and QR code data</span>
                            </label>
                            <label class="checklist-item">
                                <input type="checkbox" id="dobMatch" name="verification">
                                <span class="checkmark"></span>
                                <span class="checklist-text" data-i18n-key="identity-checklist-dob">Date of birth matches PRC and QR code data</span>
                            </label>
                            <label class="checklist-item">
                                <input type="checkbox" id="copyMade" name="verification">
                                <span class="checkmark"></span>
                                <span class="checklist-text" data-i18n-key="identity-checklist-copy">Copy made for records</span>
                            </label>
                        </div>
                    </div>
                </div>

                <!-- Mobile next steps - shown only on mobile -->
                <div class="mobile-next-steps">
                    <div class="info-box">
                        <h3 data-i18n-key="identity-next-title">Next Steps</h3>
                        <ol>
                            <li data-i18n-key="identity-next-step1">Scan QR code on PRC card</li>
                            <li data-i18n-key="identity-next-step2">Validate QR code authenticity</li>
                            <li data-i18n-key="identity-next-step3">Complete verification process</li>
                        </ol>
                    </div>
                </div>

                <div class="form-actions">
                    <button type="button" id="continueToScanning" class="btn btn-primary btn-large" disabled>
                        <span data-i18n-key="identity-button-continue">Continue to Scanning the QR Code</span>
                        <span class="btn-arrow">→</span>
                    </button>
                </div>
            </div>

            <div class="info-sidebar">
                <div class="info-box">
                    <h3 data-i18n-key="identity-why-title">Why Identity Verification?</h3>
                    <p data-i18n-key="identity-why-text">Identity verification ensures:</p>
                    <ul>
                        <li data-i18n-key="identity-why-item1">Patient authenticity</li>
                        <li data-i18n-key="identity-why-item2">Fraud prevention</li>
                        <li data-i18n-key="identity-why-item3">Compliance with regulations</li>
                        <li data-i18n-key="identity-why-item4">Accurate treatment records</li>
                    </ul>
                </div>

                <div class="info-box">
                    <h3 data-i18n-key="identity-next-title">Next Steps</h3>
                    <ol>
                        <li data-i18n-key="identity-next-step1">Scan QR code on PRC card</li>
                        <li data-i18n-key="identity-next-step2">Validate QR code authenticity</li>
                        <li data-i18n-key="identity-next-step3">Complete verification process</li>
                    </ol>
                </div>
            </div>
        </div>
    </main>

    <%- include('layouts/footer') %>    
    <script src="/js/identity-check.js"></script>
</body>
</html>