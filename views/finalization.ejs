<!DOCTYPE html>
<html lang="en">
<%- include('layouts/head', { titleKey: 'finalization-title', title: 'Finalization - EHIC Verifier', includeQRScanner: false }) %>
<body>
    <%- include('layouts/navbar') %>
    <%- include('layouts/breadcrumb') %>

    <main class="main-content">
        <div class="finalization-container">
            <div class="finalization-status">
                <span class="status-icon-large">✅</span>
                <h1 data-i18n-key="finalization-verification-complete">Verification Complete</h1>
                <p class="finalization-subtitle" data-i18n-key="finalization-all-steps-completed">All verification steps have been successfully completed</p>
            </div>

            <div class="summary-section">
                <h2 data-i18n-key="finalization-verification-summary">Verification Summary</h2>
                <div class="summary-grid">
                    <div class="summary-item">
                        <span class="summary-icon">📅</span>
                        <div class="summary-details">
                            <div class="summary-label" data-i18n-key="finalization-treatment-date">Treatment Date</div>
                            <div class="summary-value" id="treatment-date-summary">-</div>
                        </div>
                    </div>
                    <div class="summary-item">
                        <span class="summary-icon">👤</span>
                        <div class="summary-details">
                            <div class="summary-label" data-i18n-key="finalization-identity-verified">Identity Verified</div>
                            <div class="summary-value" id="identity-verification-status">
                                <span data-i18n-key="finalization-confirmed">✅ Confirmed</span>
                            </div>
                        </div>
                    </div>
                    <div class="summary-item">
                        <span class="summary-icon">📱</span>
                        <div class="summary-details">
                            <div class="summary-label" data-i18n-key="finalization-qr-code-status">QR Code Status</div>
                            <div class="summary-value" data-i18n-key="finalization-valid">✅ Valid</div>
                        </div>
                    </div>
                    <div class="summary-item">
                        <span class="summary-icon">🔐</span>
                        <div class="summary-details">
                            <div class="summary-label" data-i18n-key="finalization-digital-signature">Digital Signature</div>
                            <div class="summary-value" data-i18n-key="finalization-verified">✅ Verified</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="reference-number-section">
                <h3 data-i18n-key="finalization-reference-number">Reference Number</h3>
                <div class="reference-number" id="reference-number">-</div>
                <p class="reference-note" data-i18n-key="finalization-save-reference-note">Please save this reference number for your records</p>
            </div>

            <div class="next-steps-section">
                <h3 data-i18n-key="finalization-next-steps">Next Steps</h3>
                <ul class="next-steps-list">
                    <li data-i18n-key="finalization-step-1">The verification has been completed successfully</li>
                    <li data-i18n-key="finalization-step-2">The patient's EHIC/PRC is valid and verified</li>
                    <li data-i18n-key="finalization-step-3">You may now proceed with the treatment</li>
                    <li data-i18n-key="finalization-step-4">Keep the reference number for billing purposes</li>
                </ul>
            </div>

            <div class="email-section">
                <h3 data-i18n-key="finalization-email-summary">Email Summary</h3>
                <div class="email-form">
                    <input type="email" id="email-address" class="email-input" data-i18n-key="finalization-enter-email" placeholder="Enter email address" required>
                    <button id="send-email" class="btn btn-success" data-i18n-key="finalization-send-email">Send Email</button>
                </div>
                <div id="email-status" class="email-status"></div>
            </div>

            <div class="controls">
                <button id="print-summary" class="btn btn-secondary" data-i18n-key="finalization-print-summary">Print Summary</button>
                <a href="/" class="btn btn-primary" data-i18n-key="finalization-start-new-verification">Start New Verification</a>
            </div>
        </div>
    </main>

   <%- include('layouts/footer') %>     
   
    <script src="/js/finalization.js"></script>
</body>
</html>