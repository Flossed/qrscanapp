<!DOCTYPE html>
<html lang="en">
<%- include('layouts/head', { titleKey: 'results-title', title: 'Verification Results - EHIC Verifier', includeQRScanner: false }) %>
<body>
    <%- include('layouts/navbar') %>
    <%- include('layouts/breadcrumb') %>

    <main class="main-content">
        <div class="verification-container">
            <h1 data-i18n-key="results-title">Verification Results</h1>

            <div id="overall-status" class="overall-status">
                <!-- Overall status will be populated by JavaScript -->
            </div>

            <div id="loading" class="loading" style="display: block;">
                <p data-i18n-key="results-processing">Processing verification steps...</p>
            </div>

            <div id="error-container" class="error-container" style="display: none;">
                <h3 data-i18n-key="results-error-title">Verification Error</h3>
                <div id="error-message" class="error-message"></div>
            </div>

            <div id="verification-results" class="verification-results" style="display: none;">
                <!-- Verification steps will be populated by JavaScript -->
            </div>

            <div class="controls" style="display: none;" id="action-buttons">
                <button id="continue-identity-check" class="btn btn-primary" data-i18n-key="results-continue-identity">Continue to Scan Document</button>
            </div>
        </div>
    </main> 


    <%- include('layouts/footer') %>    

    <script src="/js/results.js"></script>
</body>
</html>