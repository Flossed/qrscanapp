<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <title data-i18n-key="results-title">Verification Results - EHIC Verifier</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <nav class="navbar">
        <div class="nav-container">
            <a href="/" class="nav-brand" data-i18n-key="nav-brand">EHIC Verifier</a>
            <div class="nav-menu">
                <a href="/" class="nav-link" data-i18n-key="nav-home">Home</a>
                <a href="/scanner" class="nav-link" data-i18n-key="nav-scanner">Scanner</a>
                <a href="/history" class="nav-link" data-i18n-key="nav-history">History</a>

                <a href="#" class="nav-link active" data-i18n-key="results-nav-results">Results</a>
            </div>
            <div class="language-selector-container">
                <select id="languageSelector" class="language-selector">
                    <option value="en">English</option>
                    <option value="nl">Nederlands</option>
                </select>
            </div>
        </div>
    </nav>

    <div class="breadcrumb-container">
        <nav class="breadcrumb">
            <a href="/" class="breadcrumb-item completed">
                <span class="step-number">1</span>
                <span data-i18n-key="landing-breadcrumb-welcome">Welcome</span>
            </a>
            <span class="breadcrumb-separator">→</span>
            <a href="/treatment-date" class="breadcrumb-item completed">
                <span class="step-number">2</span>
                <span data-i18n-key="landing-breadcrumb-treatment-date">Treatment Date</span>
            </a>
            <span class="breadcrumb-separator">→</span>
            <a href="/identity-check" class="breadcrumb-item completed">
                <span class="step-number">3</span>
                <span data-i18n-key="landing-breadcrumb-identity-check">Identity Check</span>
            </a>
            <span class="breadcrumb-separator">→</span>
            <a href="/scanner" class="breadcrumb-item completed">
                <span class="step-number">4</span>
                <span data-i18n-key="landing-breadcrumb-qr-verification">QR Verification</span>
            </a>
            <span class="breadcrumb-separator">→</span>
            <span class="breadcrumb-item active">
                <span class="step-number">5</span>
                <span data-i18n-key="landing-breadcrumb-results">Results</span>
            </span>
        </nav>
    </div>

    <main class="main-content">
        <div class="verification-container">
            <h1 data-i18n-key="results-title">Verification Results</h1>

            <div id="overall-status" class="overall-status">
                <!-- Overall status will be populated by JavaScript -->
            </div>

            <div id="loading" class="loading" style="display: block;">
                <p data-i18n-key="results-processing">Processing verification steps...</p>
            </div>

            <div id="error-container" class="error-container" style="display: none;">
                <h3 data-i18n-key="results-error-title">Verification Error</h3>
                <div id="error-message" class="error-message"></div>
            </div>

            <div id="verification-results" class="verification-results" style="display: none;">
                <!-- Verification steps will be populated by JavaScript -->
            </div>

            <div class="controls" style="display: none;" id="action-buttons">
                <button id="finalize-verification" class="btn btn-primary" data-i18n-key="results-continue-finalize">Continue to Finalize Verification</button>
            </div>
        </div>
    </main>

    <footer class="footer">
        <p data-i18n-key="footer-copyright">&copy; 2024 EHIC Verifier App - Healthcare Provider Solution</p>
    </footer>


    <script src="/js/manageLocale.js"></script>
    <script src="/js/results.js"></script>
</body>
</html>