<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <title>EHIC Verifier - Treatment Date</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <nav class="navbar">
        <div class="nav-container">
            <a href="/" class="nav-brand" data-i18n-key="nav-brand">EHIC Verifier</a>
            <div class="nav-menu">
                <a href="/" class="nav-link" data-i18n-key="nav-home">Home</a>
                <a href="/scanner" class="nav-link" data-i18n-key="nav-scanner">Scanner</a>
                <a href="/history" class="nav-link" data-i18n-key="nav-history">History</a>
            </div>
            <div class="language-selector-container">
                <select id="languageSelector" class="language-selector">
                    <option value="en">English</option>
                    <option value="nl">Nederlands</option>
                </select>
            </div>
        </div>
    </nav>

    <div class="breadcrumb-container">
        <nav class="breadcrumb">
            <a href="/" class="breadcrumb-item completed">
                <span class="step-number">1</span>
                <span data-i18n-key="landing-breadcrumb-welcome">Welcome</span>
            </a>
            <span class="breadcrumb-separator">→</span>
            <span class="breadcrumb-item active">
                <span class="step-number">2</span>
                <span data-i18n-key="landing-breadcrumb-treatment-date">Treatment Date</span>
            </span>
            <span class="breadcrumb-separator">→</span>
            <span class="breadcrumb-item disabled">
                <span class="step-number">3</span>
                <span data-i18n-key="landing-breadcrumb-identity-check">Identity Check</span>
            </span>
            <span class="breadcrumb-separator">→</span>
            <span class="breadcrumb-item disabled">
                <span class="step-number">4</span>
                <span data-i18n-key="landing-breadcrumb-qr-verification">QR Verification</span>
            </span>
            <span class="breadcrumb-separator">→</span>
            <span class="breadcrumb-item disabled">
                <span class="step-number">5</span>
                <span data-i18n-key="landing-breadcrumb-results">Results</span>
            </span>
        </nav>
    </div>

    <main class="main-content">
        <div class="treatment-date-container">
            <!-- Mobile why treatment date - shown only on mobile between breadcrumb and form -->
            <div class="mobile-why-treatment">
                <div class="info-box">
                    <h3 data-i18n-key="treatment-why-title">Why Treatment Date?</h3>
                    <p data-i18n-key="treatment-why-text">The treatment date helps ensure:</p>
                    <ul>
                        <li data-i18n-key="treatment-why-item1">Accurate reimbursement calculations</li>
                        <li data-i18n-key="treatment-why-item2">Proper coverage validation</li>
                        <li data-i18n-key="treatment-why-item3">Administrative compliance</li>
                    </ul>
                </div>
            </div>

            <div class="form-container">
                <div class="form-header">
                    <h1 data-i18n-key="treatment-title">Treatment Date</h1>
                    <p data-i18n-key="treatment-subtitle">Please specify the date when the treatment occurred (defaults to today)</p>
                </div>

                <form id="treatmentDateForm" class="treatment-form">
                    <div class="form-group">
                        <label for="treatmentDate" class="form-label">
                            <span class="label-text" data-i18n-key="treatment-date-label">Treatment Date</span>
                            <span class="label-optional" data-i18n-key="treatment-date-optional">(Optional)</span>
                        </label>
                        <div class="date-input-wrapper">
                            <input
                                type="date"
                                id="treatmentDate"
                                name="treatmentDate"
                                class="form-input date-input"
                                min=""
                                max=""
                                value=""
                            >
                            <div class="date-input-overlay" id="dateOverlay">dd/mm/yyyy</div>
                        </div>
                        <div class="input-help">
                            <span class="help-icon">💡</span>
                            <span data-i18n-key="treatment-date-help">Defaults to today. Click to select a different date (up to 30 days in the future)</span>
                        </div>
                    </div>


                    <div class="form-group">
                        <label for="notes" class="form-label">
                            <span class="label-text" data-i18n-key="treatment-notes-label">Additional Notes</span>
                            <span class="label-optional" data-i18n-key="treatment-notes-optional">(Optional)</span>
                        </label>
                        <textarea
                            id="notes"
                            name="notes"
                            class="form-input textarea-input"
                            data-i18n-placeholder="treatment-notes-placeholder"
                            placeholder="Any additional information about the treatment..."
                            rows="15"
                            cols="80"
                            maxlength="1200"
                        ></textarea>
                    </div>

                    <!-- Mobile next steps - shown only on mobile between input and button -->
                    <div class="mobile-next-steps">
                        <div class="info-box">
                            <h3 data-i18n-key="treatment-next-title">Next Steps</h3>
                            <ol>
                                <li data-i18n-key="treatment-next-step1">Verify patient identity document</li>
                                <li data-i18n-key="treatment-next-step2">Scan QR code on PRC card</li>
                                <li data-i18n-key="treatment-next-step3">Complete verification process</li>
                            </ol>
                        </div>
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn btn-primary btn-large">
                            <span data-i18n-key="treatment-button-continue">Continue to Identity Check</span>
                            <span class="btn-arrow">→</span>
                        </button>
                    </div>
                </form>
            </div>

            <div class="info-sidebar">
                <div class="info-box">
                    <h3 data-i18n-key="treatment-why-title">Why Treatment Date?</h3>
                    <p data-i18n-key="treatment-why-text">The treatment date helps ensure:</p>
                    <ul>
                        <li data-i18n-key="treatment-why-item1">Accurate reimbursement calculations</li>
                        <li data-i18n-key="treatment-why-item2">Proper coverage validation</li>
                        <li data-i18n-key="treatment-why-item3">Administrative compliance</li>
                    </ul>
                </div>

                <div class="info-box">
                    <h3 data-i18n-key="treatment-next-title">Next Steps</h3>
                    <ol>
                        <li data-i18n-key="treatment-next-step1">Verify patient identity document</li>
                        <li data-i18n-key="treatment-next-step2">Scan QR code on PRC card</li>
                        <li data-i18n-key="treatment-next-step3">Complete verification process</li>
                    </ol>
                </div>
            </div>
        </div>
    </main>

    <footer class="footer">
        <p data-i18n-key="footer-copyright">&copy; 2024 EHIC Verifier App - Healthcare Provider Solution</p>
    </footer>

    <script src="/js/manageLocale.js"></script>
    <script src="/js/treatment-date.js"></script>
</body>
</html>