<!DOCTYPE html>
<html lang="en">
<%- include('layouts/head', { titleKey: 'verify-title', title: 'QR Code Verification - QR Scanner', includeQRScanner: false }) %>
<body>
    <%- include('layouts/navbar', { currentPage: '' }) %>

    <main class="main-content">
        <div class="verification-container">
            <h1 data-i18n-key="verify-title">QR Code Verification</h1>
            <p class="verification-subtitle" data-i18n-key="verify-subtitle">BASE45 → ZLIB → JWT Decoder</p>

            <div class="controls">
                <button id="process-verification" class="btn btn-primary" data-i18n-key="verify-process-button">Process Verification</button>
                <a href="/scan-history" class="btn btn-secondary" data-i18n-key="verify-back-button">Back to History</a>
            </div>

            <div id="loading" class="loading" style="display: none;">
                <p data-i18n-key="verify-processing">Processing verification steps...</p>
            </div>

            <div id="error-container" class="error-container" style="display: none;">
                <h3 data-i18n-key="verify-error-title">Verification Error</h3>
                <div id="error-message" class="error-message"></div>
            </div>

            <div id="verification-steps" class="verification-steps">
                <!-- Steps will be populated by JavaScript -->
            </div>
        </div>
    </main>

    <%- include('layouts/footer') %>

    <script src="/js/verify.js"></script>
</body>
</html>