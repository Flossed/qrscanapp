<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <title>QR Code Scanner</title>
    <link rel="stylesheet" href="/css/style.css">
    <script src="https://unpkg.com/html5-qrcode" type="text/javascript"></script>
</head>
<body>
    <nav class="navbar">
        <div class="nav-container">
            <a href="/" class="nav-brand" data-i18n-key="nav-brand">EHIC Verifier</a>
            <div class="nav-menu">
                <a href="/" class="nav-link" data-i18n-key="nav-home">Home</a>
                <a href="/scanner" class="nav-link active" data-i18n-key="nav-scanner">Scanner</a>
                <a href="/history" class="nav-link" data-i18n-key="nav-history">History</a>
                <a href="/check-bridge" class="nav-link" data-i18n-key="nav-check-bridge">Check Bridge</a>
            </div>
            <div class="language-selector-container">
                <select id="languageSelector" class="language-selector">
                    <option value="en">English</option>
                    <option value="nl">Nederlands</option>
                </select>
            </div>
        </div>
    </nav>

    <div class="breadcrumb-container">
        <nav class="breadcrumb">
            <a href="/" class="breadcrumb-item completed">
                <span class="step-number">1</span>
                <span data-i18n-key="landing-breadcrumb-welcome">Welcome</span>
            </a>
            <span class="breadcrumb-separator">→</span>
            <a href="/treatment-date" class="breadcrumb-item completed">
                <span class="step-number">2</span>
                <span data-i18n-key="landing-breadcrumb-treatment-date">Treatment Date</span>
            </a>
            <span class="breadcrumb-separator">→</span>
            <a href="/identity-check" class="breadcrumb-item completed">
                <span class="step-number">3</span>
                <span data-i18n-key="landing-breadcrumb-identity-check">Identity Check</span>
            </a>
            <span class="breadcrumb-separator">→</span>
            <span class="breadcrumb-item active">
                <span class="step-number">4</span>
                <span data-i18n-key="landing-breadcrumb-qr-verification">QR Verification</span>
            </span>
            <span class="breadcrumb-separator">→</span>
            <span class="breadcrumb-item disabled">
                <span class="step-number">5</span>
                <span data-i18n-key="landing-breadcrumb-results">Results</span>
            </span>
        </nav>
    </div>

    <main class="main-content">
        <div class="scanner-container">
            <h1 data-i18n-key="scan-title">Scan QR Code</h1>

            <div id="reader" class="qr-reader"></div>

            <div class="controls">
                <button id="start-scanner" class="btn btn-primary" data-i18n-key="scan-start-scanner">Start Scanner</button>
                <button id="stop-scanner" class="btn btn-secondary" style="display: none;" data-i18n-key="scan-stop-scanner">Stop Scanner</button>
            </div>

            <div id="result-container" class="result-container" style="display: none;">
                <h2 data-i18n-key="scan-result-title">Scan Result</h2>
                <div id="result" class="result-text"></div>
                <button id="save-scan" class="btn btn-success" data-i18n-key="scan-verify-qr">Verify QR Code</button>
                <button id="show-results" class="btn btn-info" data-i18n-key="scan-show-results">Show Verification Results</button>
                <button id="scan-again" class="btn btn-primary" data-i18n-key="scan-again">Scan Again</button>
            </div>

            <div id="message" class="message"></div>
        </div>
    </main>

    <footer class="footer">
        <p data-i18n-key="footer-copyright">&copy; 2024 EHIC Verifier App - Healthcare Provider Solution</p>
    </footer>

    <script src="/js/manageLocale.js"></script>
    <script src="/js/scan.js"></script>

</body>
</html>